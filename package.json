{
  "name": "@newgentdigital/auto-param-astro",
  "version": "2.1.0",
  "private": false,
  "description": "Automatically add your parameters to external links and URLs during build time with Astro.",
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "plugin",
    "seo",
    "tooling",
    "utils",
    "withastro"
  ],
  "homepage": "https://github.com/newgentdigital/auto-param-astro",
  "bugs": {
    "url": "https://github.com/newgentdigital/auto-param-astro",
    "email": "engineering@newgent.digital"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Newgent",
    "email": "engineering@newgent.digital",
    "url": "https://newgent.digital/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newgentdigital/auto-param-astro.git"
  },
  "funding": "https://github.com/sponsors/newgentdigital",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --tsconfig tsconfig.test.json",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.test.json --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "astro": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
